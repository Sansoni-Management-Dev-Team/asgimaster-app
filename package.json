{
  "name": "mlai-sansoni",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @mlai-sansoni/mobile",
    "ios": "npm run ios -w @mlai-sansoni/mobile",
    "android": "npm run android -w @mlai-sansoni/mobile",
    "web": "npm run web -w @mlai-sansoni/mobile",
    "api:dev": "npm run dev -w @mlai-sansoni/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
