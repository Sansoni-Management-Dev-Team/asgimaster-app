{
  "name": "mlai-sansoni",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @mlai-sansoni/mobile",
    "ios": "npm run ios -w @mlai-sansoni/mobile",
    "android": "npm run android -w @mlai-sansoni/mobile",
    "web": "npm run web -w @mlai-sansoni/mobile",
    "web:build": "EXPO_PUBLIC_API_URL=same-origin npm exec --workspace @mlai-sansoni/mobile -- expo export --platform web --output-dir ../api/public/app",
    "api:dev": "npm run dev -w @mlai-sansoni/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "e2e": "npm run e2e -w @mlai-sansoni/mobile --",
    "auth:up": "node apps/api/scripts/local.mjs up",
    "auth:down": "node apps/api/scripts/local.mjs down",
    "api:migrate": "npm run db:migrate -w @mlai-sansoni/api",
    "api:bootstrap": "npm run bootstrap -w @mlai-sansoni/api --",
    "api:mail": "npm run outbox -w @mlai-sansoni/api",
    "api:test:integration": "npm run test:integration -w @mlai-sansoni/api"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
