# Public runtime configuration. A Sentry DSN is an ingest address, not an auth token.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=develop
# Build-only environment: SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN.
# Supply the upload token through EAS secret storage; never EXPO_PUBLIC_* or extra.
