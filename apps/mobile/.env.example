# Public runtime configuration. A Sentry DSN is an ingest address, not an auth token.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=develop
# Build-only environment: SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN.
# Supply the upload token through EAS secret storage; never EXPO_PUBLIC_* or extra.

# Local Metro requires explicit develop; production is never inferred in development.
# Installed release bundles use the native Updates.channel when available. Unknown
# downloaded channels disable reporting; build-profile env is used only by embedded
# or updates-disabled bundles. OTA publishing/activation is not configured here.
# Source-map auto upload is disabled in every EAS profile pending activation.
