# Local-only settings for compose.auth.yml; generate real secrets for each environment.
NODE_ENV=development
PORT=8789
HOST=0.0.0.0
DATABASE_URL=postgres://sansoni:local-only@127.0.0.1:55439/sansoni
BETTER_AUTH_URL=http://localhost:8789
BETTER_AUTH_SECRET=local-only-replace-with-a-random-secret-32-chars-minimum
OUTBOX_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
MAIL_FROM=sansoni@example.test
MAIL_TRANSPORT=capture
# Optional for SES: verified mailbox for bounce and complaint feedback.
# MAIL_FEEDBACK_TO=feedback@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=51029
# Production uses verified TLS to Postgres, SES and explicit proxy CIDRs.
# DATABASE_CA_FILE=/run/certs/rds-ca.pem
# TRUSTED_PROXY_CIDRS=10.0.0.0/24,10.0.1.0/24
# AWS_REGION=ap-southeast-2
# Or DATABASE_CA_BASE64=<base64 of the reviewed RDS CA bundle> in production secrets.

# Optional source credentials. The current read-only adapters are stubs: setting
# these only marks connection setup as pending; it does not fetch or verify data.
# Missing credentials leave saved member accounts and invitations usable.
# MAXIO_AU_API_KEY=
# MAXIO_NZ_API_KEY=
# HUBSPOT_ACCESS_TOKEN=

# Optional for local/shared admin previews: allow any Origin and skip staff-form
# CSRF token validation. Still requires named staff + OTP for protected pages.
# Rejected outside NODE_ENV=development or when using real email delivery.
# DEV_RELAX_ADMIN_CSRF=true
