{
  "name": "@mlai-sansoni/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "auth:generate": "auth generate --config auth-generation.ts --output src/db/auth-schema.ts --yes",
    "bootstrap": "tsx --env-file-if-exists=.env.local src/commands.ts",
    "outbox": "tsx --env-file-if-exists=.env.local src/mail-worker.ts",
    "test:integration": "tsx --test src/integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1153.0",
    "@better-auth/drizzle-adapter": "1.7.11",
    "@hono/node-server": "^2.1.3",
    "@mlai-sansoni/contracts": "1.0.0",
    "@sentry/node": "10.37.0",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "htmx.org": "4.0.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.16.0",
    "auth": "1.7.11",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
